{
  "compilerOptions": {
    "checkJs": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"]
    },
    "jsx": "preserve"
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "electron.vite.config.mjs"]
}
